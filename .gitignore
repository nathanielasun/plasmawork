# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.tox/

# Node / TypeScript
node_modules/
dist/
# Anchored to root: top-level build output only. We have a `scripts/build/`
# directory of build scripts that must remain versioned. Per-app and per-package
# `build/` artifacts are ignored explicitly below. NEVER reintroduce a bare
# `build/` rule — it swallows `scripts/build/` (see bugs_and_fixes/bugfixes.md
# 2026-05-02 *Bare `build/` ignore rule*).
/build/
apps/*/build/
packages/*/build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo
next-env.d.ts
# Defensive: TypeScript should never emit .js / .d.ts into src/ — production
# builds use bundlers (vite) and tsconfig's `noEmit: true` enforces that. If a
# `tsc -b` invocation slips through, these rules keep emitted artifacts out
# of git. (Regression-driven: post-Phase-2-close audit found leaked .js
# duplicates next to .tsx files; see agent_error_patterns.md "Build script
# emits compile artifacts into the source tree".)
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
docs_site/src/**/*.js
docs_site/src/**/*.d.ts
# Hand-authored ambient-type files are NOT emit leaks; re-include them.
!apps/*/src/vite-env.d.ts
!docs_site/src/vite-env.d.ts
.pnp
.pnp.js

# Local program directories — keep folders, ignore contents
local_cache/*
temp_imports/*
temp_runs/*
simulation_capsules/*
!local_cache/.gitkeep
!temp_imports/.gitkeep
!temp_runs/.gitkeep
!simulation_capsules/.gitkeep

# Simulation outputs
*.h5
*.hdf5
*.zarr/
*.openpmd/
*.vtk
*.vti
*.vtu
*.xdmf
*.bp
*.bp5
*.parquet
*.npy
*.npz

# Logs and temporary files
*.log
*.tmp
*.temp
*.cache
.DS_Store

# Keep canonical bug log template under a non-.log name (program.log.example)
!bugs_and_fixes/program.log.example

# Local config / secrets
.env
.env.*
*.local.yaml
*.local.json
.vercel

# Secrets store (ADR-0011 L1.6). Defense in depth: `*.local.json` above
# already matches this path, and `local_cache/*` ignores the whole directory.
# This explicit rule survives any future relaxation of the broader rules.
local_cache/secrets/secrets.local.json

# IDE / editor
.vscode/
.idea/
*.pem
