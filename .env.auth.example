# Workbench gateway authentication config — Phase 0.5 (2026-05-09).
#
# Copy this file to /.env.auth at repo root (NOT inside this package
# directory). The repo-root copy is the canonical config; the gateway
# loader reads /.env.auth via dotenv with strict-unset enforcement.
#
# /.env.auth IS NOT committed. /.env.auth.example IS committed and
# MUST be kept in sync with the gateway's `src/env.ts` validation.

# ---------------------------------------------------------------------
# Bootstrap (one-shot, sealed by WORM marker after first success).
# ---------------------------------------------------------------------

# Set to "1" to enable POST /bootstrap. Any other value (including
# unset) closes the gate and the route is not registered.
BOOTSTRAP_ALLOWED=1

# SHA-256 hex of the OOB bootstrap credential string. The operator
# generates a one-time string out-of-band, hashes it, sets the hash
# here, and POSTs the plaintext credential to /bootstrap. Constant-
# time-compared inside BootstrapService.
#
# Generate via: echo -n '<your-credential>' | sha256sum
BOOTSTRAP_CREDENTIAL_HASH=

# The seeded root admin's username (alphanumeric + underscore + hyphen,
# 3-64 chars). The bootstrap request's `admin_username` field MUST
# equal this value or the request is rejected. Phase 0.5 chose the
# username-only model deliberately: the seeded admin has no email of
# record, so email-based password recovery is unavailable. Recovery
# requires the manual re-bootstrap runbook (see LIMITATIONS.md).
ROOT_ADMIN_USER_ID=

# ---------------------------------------------------------------------
# Gateway runtime.
# ---------------------------------------------------------------------

# The public-facing port the gateway listens on.
WORKBENCH_GATEWAY_PORT=4000

# The loopback-only port the FastAPI workbench listens on. The gateway
# proxies /api/* requests here AFTER signing the X-Workbench-* headers.
# scripts/dev/run_backend.sh binds to 127.0.0.1 only.
WORKBENCH_BACKEND_PORT=8000

# Cookie signing secret. ≥32 bytes of CSPRNG-generated entropy
# (base64-encoded). Used by @fastify/cookie for HMAC-signed cookies.
# Generate via: openssl rand -base64 32
WORKBENCH_GATEWAY_COOKIE_SECRET=

# HMAC-SHA256 signing key for the X-Workbench-* forwarded headers.
# ≥32 bytes of CSPRNG-generated entropy (base64-encoded). The FastAPI
# auth_middleware.py recomputes the same HMAC and constant-time-
# compares; spoofed headers from a colocated process are rejected.
# Generate via: openssl rand -base64 32
WORKBENCH_GATEWAY_HANDOFF_SECRET=

# Front-end origin allowed by enforceCsrfForStateChange. Set to the
# scheme://host[:port] the workbench-ui is served from.
WORKBENCH_GATEWAY_FRONTEND_ORIGIN=https://app.plasmawork.local

# ---------------------------------------------------------------------
# Database connections (also read by secure_core via readSecureCoreEnv).
# ---------------------------------------------------------------------

# secure_core_app role — primary read+write pool.
PLASMAWORK_DB_URL=

# secure_core_audit_writer role — separate hash-chained pool for the
# append-only audit/provenance/operator event tables.
PLASMAWORK_DB_AUDIT_URL=
